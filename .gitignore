# ── Python ───────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ── 仮想環境 ─────────────────────────────────────────────
.venv/
venv/

# ── テスト / カバレッジ ──────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── 環境変数 ─────────────────────────────────────────────
# deploy が APP_IMAGE / PROXY_IMAGE（digest 固定参照）を書き出す先。環境別ファイルも除外する
.env
.env.*
# テンプレートはコミット対象として除外解除（行末コメント不可のため独立行）
!.env.example

# ── 証明書・秘密鍵（HTTPS / Let's Encrypt）───────────────
# certbot が取得した証明書とアカウント鍵の保存先（ホスト上にのみ存在させる）
certbot/
*.pem
*.key

# ── 一時ファイル ─────────────────────────────────────────
# SSM デプロイ（CI ランナー）が生成する一時ファイル
params.json

# ── ログ ─────────────────────────────────────────────────
*.log

# ── エディタ / IDE 設定 ──────────────────────────────────
.vscode/
.idea/
*.swp

# ── OS 生成ファイル ──────────────────────────────────────
# Windows
Thumbs.db
Desktop.ini
# macOS
.DS_Store
