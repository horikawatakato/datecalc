.env
.env.*
# テンプレートはコミット対象として除外解除
!.env.example

# 証明書・秘密鍵（TLS 証明書・SSH/各種秘密鍵）
# certbot/ の証明書・アカウント鍵はホスト上にのみ存在
certbot/
*.pem
*.key

# 一時ファイル
# SSM デプロイ（CI ランナー）が生成する一時ファイル
params.json
remote.sh

# ログ
*.log

# エディタ / IDE
.vscode/
.idea/
*.swp

